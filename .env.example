# Jai Kisan Backend
DATABASE_URL=sqlite+aiosqlite:///./jai_kisan.db
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Weather Provider
WEATHER_PROVIDER=open_meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# LLM Provider (optional — runs in demo mode without this)
LLM_PROVIDER=demo
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=gemini-pro

# Notifications (optional — runs in demo mode without this)
NOTIFICATION_PROVIDER=in_app
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Voice/Translation (optional)
VOICE_PROVIDER=browser
# BHASHINI_API_KEY=your-key-here

# Application
APP_NAME=Jai Kisan
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
